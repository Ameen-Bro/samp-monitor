# Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_guild_id_here

# Timezone (all display timestamps use this zone)
TIMEZONE=Asia/Kolkata

# Query Settings (these can also be set via /server-config)
QUERY_INTERVAL_SECONDS=30
MISSED_QUERY_THRESHOLD=3

# Optional: Admin Role ID (overrides Discord Administrator permission check)
# ADMIN_ROLE_ID=

# Optional: Log Channel ID for daily reports
# LOG_CHANNEL_ID=

# Daily Report Schedule (24h format, in configured TIMEZONE)
DAILY_REPORT_HOUR=23
DAILY_REPORT_MINUTE=59

# NOTE: SA-MP server IP/port are NOT configured here.
# Use the /server-config set command in Discord to configure your server.
# This ensures the bot is fully configurable without editing any files.
