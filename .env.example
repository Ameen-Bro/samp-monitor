# ==========================================
# SA-MP / Open.MP PD Officer Monitor Configuration
# ==========================================

# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
# Optional: Set GUILD_ID for instant slash command registration in your test server
DISCORD_GUILD_ID=

# Target Game Server (Public UDP Query)
SAMP_SERVER_IP=139.99.52.211
SAMP_SERVER_PORT=7777

# Timezone for display and midnight splits
TIMEZONE=Asia/Kolkata

# Automated Polling Configuration
QUERY_INTERVAL_SECONDS=30
MISSED_QUERY_THRESHOLD=3

# Permissions & Logging
# Optional: Role ID allowed to /add-officer and /remove-officer (defaults to Server Administrators if empty)
ADMIN_ROLE_ID=
# Optional: Channel ID where daily PD patrol reports will be automatically posted
LOG_CHANNEL_ID=
# Daily report trigger time in configured timezone (24-hour format)
DAILY_REPORT_HOUR=23
DAILY_REPORT_MINUTE=59
