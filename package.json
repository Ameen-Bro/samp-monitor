    "ffmpeg-static": "^5.3.0",
    "node-cron": "^3.0.3",
    "opusscript": "^0.0.8",
    "play-dl": "^1.9.7",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/node-cron": "^3.0.11",
